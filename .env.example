# Ne jamais préfixer les secrets par VITE_ (exposés au navigateur).
# Sélection explicite : openai, gemini, groq ou deepseek. Une valeur vide conserve OpenAI.
# Render injecte PORT automatiquement. En local, le serveur conserve le port 3000.
PORT=

AI_PROVIDER=

# Configuration OpenAI, exclusivement côté serveur.
# OPENAI_API_KEY est requise uniquement lorsque OpenAI est sélectionné.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_TIMEOUT_MS=30000

# Configuration Gemini, exclusivement côté serveur.
# GEMINI_API_KEY est requise uniquement lorsque AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# Configuration Groq, exclusivement côté serveur.
# GROQ_API_KEY est requise uniquement lorsque AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000

# Configuration DeepSeek, exclusivement côté serveur.
# DEEPSEEK_API_KEY est requise uniquement lorsque AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Deadline UX LaneLens ; le timeout transport doit rester strictement supérieur.
DEEPSEEK_TIMEOUT_MS=90000
DEEPSEEK_TRANSPORT_TIMEOUT_MS=100000
# Politique dédiée aux campagnes ; elle n'hérite pas de la deadline applicative.
DEEPSEEK_EVALUATION_TIMEOUT_MS=120000
DEEPSEEK_EVALUATION_TRANSPORT_TIMEOUT_MS=130000

# Launcher local du runner gameplay (optionnel, chemins non versionnés).
LANELENS_EVALUATION_CORPUS=
LANELENS_EVALUATION_RESULTS=

# Logs backend locaux et persistants.
LOG_DIR=./logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# Création de tickets de feedback, exclusivement côté serveur.
# Laisser les trois valeurs vides désactive uniquement POST /api/feedback.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_OWNER=
FEEDBACK_GITHUB_REPOSITORY=
