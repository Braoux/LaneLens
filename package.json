{
  "name": "lanelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "concurrently --raw --kill-others \"npm:dev:server\" \"npm:dev:client:wait\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:client:wait": "wait-on http-get://127.0.0.1:3000/api/health && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start:server": "node dist/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@hono/node-server": "^2.1.1",
    "dotenv": "^18.0.3",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.9",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "global": "^4.4.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
